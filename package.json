    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
